{
  "plan_name": "Japanese Mission 14-Week Plan",
  "profiles": [
    "intensive",
    "standard"
  ],
  "defaults": {
    "min_new_per_day": 4,
    "normal_new_per_day_range": [
      6,
      12
    ],
    "max_new_per_day": 18,
    "review_warning_thresholds": {
      "intensive": 180,
      "standard": 120
    }
  },
  "adaptive_formula": {
    "base": "ceil(remaining_active_new / remaining_study_days)",
    "adjustments": [
      {
        "if": "backlog_due > 120",
        "then": "target = max(4, base_target - 2)"
      },
      {
        "if": "accuracy_7d >= 0.90 and consecutive_missed_days == 0",
        "then": "target = min(18, base_target + 1)"
      },
      {
        "if": "accuracy_7d < 0.75",
        "then": "target = max(4, base_target - 1)"
      },
      {
        "else": "target = base_target"
      }
    ]
  },
